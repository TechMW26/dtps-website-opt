# Firebase Admin (server-only)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
FIREBASE_DATABASE_ID=your-named-database

# Or use the shared DTPS staging variable names:
# FIRESTORE_NATIVE_PROJECT_ID=your-project-id
# FIRESTORE_NATIVE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIRESTORE_NATIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# FIRESTORE_NATIVE_DATABASE_ID=dtps-native-staging

# Reuse the existing website Vercel Blob store token; do not create a new store.
BLOB_READ_WRITE_TOKEN=existing-store-token
