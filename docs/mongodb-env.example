# Server-only. URL-encode the database password; never use NEXT_PUBLIC_*.
MONGODB_URI=mongodb+srv://<website-user>:<encoded-password>@<atlas-host>/dtps_website?retryWrites=true&w=majority&authSource=admin
MONGODB_DATABASE=dtps_website

# Keep the existing token and existing media URLs. No media migration is needed.
BLOB_READ_WRITE_TOKEN=<existing-vercel-blob-token>

# Only during final database reconciliation; omit in normal operation.
# WEBSITE_MIGRATION_READ_ONLY=true
